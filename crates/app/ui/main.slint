import { ScrollView, Spinner, Palette as SysPalette } from "std-widgets.slint";


// ---------------------------------------------------------------- WinUI 3 style theme
// Same names as the std widgets, so every screen picks up the look without changes.
/// What kind of device this is, set from Rust at start-up. Touch phones/tablets get bigger tap targets;
/// TVs get a D-pad (arrows move focus, Select activates) and larger everything.
export global Device {
    in property <bool> touch: false;
    in property <bool> tv: false;
    /// Mouse and keyboard (Windows): hover effects, tray, window options.
    out property <bool> desktop: !touch && !tv;
}

/// Hovering a poster fades the window background to that title's banner art (Settings > Appearance).
export global Hover {
    in-out property <image> image;
    in-out property <bool> active: false;
    callback entered(string, string);
    callback left();
}

/// Home-screen / grid card size multiplier (Settings > Appearance).
export global Scale {
    in-out property <float> base: 1.0;
    in-out property <bool> auto: false;
    in-out property <length> window-w: 1400px;
    in-out property <length> window-h: 900px;
    // Auto size shrinks cards (down to 70%) once the window is narrower than 1400px.
    out property <float> factor: base * (auto ? clamp(window-w / 1400px, 0.7, 1.0) : 1.0) * (Device.tv ? 1.25 : 1.0);
}

export global Palette {
    /// 0 solid, 1 Mica, 2 Acrylic (set from Rust)
    in-out property <int> material: 0;
    /// The accent colour everything is derived from: the Windows accent or a picked colour.
    in-out property <color> seed: #60cdff;
    property <float> hue: seed.to-hsv().hue;
    property <float> sat: seed.to-hsv().saturation;
    property <float> asat: sat < 0.08 ? 0.0 : clamp(sat, 0.35, 0.78);
    property <float> ssat: sat < 0.08 ? 0.0 : 1.0;
    property <float> shue: mod(hue + 20, 360);
    out property <bool> dark: SysPalette.color-scheme != ColorScheme.light;
    out property <bool> glassy: material > 0;
    // surfaces take a faint tint of the accent hue (Material You style)
    out property <color> background: dark ? Colors.hsv(shue, 0.48 * ssat, 0.16, 1) : Colors.hsv(shue, 0.05 * ssat, 0.97, 1);
    out property <color> alternate-background: glassy ? (dark ? #0c101c99 : #ffffffb8) : (dark ? Colors.hsv(shue, 0.46 * ssat, 0.20, 1) : #ffffff);
    out property <color> control-background: glassy ? (dark ? #ffffff14 : #ffffffb0) : (dark ? Colors.hsv(shue, 0.42 * ssat, 0.23, 1) : #ffffff);
    out property <color> control-hover: glassy ? (dark ? #ffffff24 : #ffffffd8) : (dark ? Colors.hsv(shue, 0.38 * ssat, 0.28, 1) : Colors.hsv(shue, 0.06 * ssat, 0.94, 1));
    out property <color> border: glassy ? (dark ? #ffffff28 : #0000001c) : (dark ? Colors.hsv(shue, 0.38 * ssat, 0.31, 1) : Colors.hsv(shue, 0.08 * ssat, 0.88, 1));
    out property <color> foreground: dark ? #ffffff : #1b1f27;
    out property <color> accent-background: dark ? Colors.hsv(hue, asat, 1.0, 1) : Colors.hsv(hue, sat < 0.08 ? 0.0 : clamp(sat, 0.6, 1.0), 0.78, 1);
    out property <color> accent-foreground: dark ? Colors.hsv(hue, 0.7 * ssat, 0.14, 1) : #ffffff;
    // Slint has no backdrop blur, so on phones and TVs (where the content behind is busy and the text must
    // stay readable) the navigation is a solid surface; on desktop it stays glass over the window material.
    out property <color> nav-glass: Device.desktop ? (dark ? #ffffff16 : #ffffffc0) : (dark ? Colors.hsv(shue, 0.42 * ssat, 0.20, 0.98) : #fffffff8);
    out property <color> glass-border: dark ? #ffffff30 : #0000001c;
    out property <brush> window-bg: glassy
        ? (dark ? @linear-gradient(180deg, #0a0e1a55 0%, #0a0e1a88 100%) : @linear-gradient(180deg, #ffffff44 0%, #ffffff44 100%))
        : (dark
            ? @linear-gradient(160deg, Colors.hsv(shue, 0.50 * ssat, 0.13, 1) 0%, Colors.hsv(shue, 0.47 * ssat, 0.17, 1) 55%, Colors.hsv(shue, 0.46 * ssat, 0.20, 1) 100%)
            : @linear-gradient(180deg, Colors.hsv(shue, 0.05 * ssat, 0.97, 1) 0%, Colors.hsv(shue, 0.05 * ssat, 0.97, 1) 100%));
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: Device.touch ? 44px : 32px;
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Palette.border;
    background: !root.enabled ? (root.primary ? Palette.accent-background.with-alpha(0.4) : Palette.control-background.with-alpha(0.5))
        : root.primary ? (ta.pressed ? Palette.accent-background.darker(0.2) : (ta.has-hover ? Palette.accent-background.brighter(0.1) : Palette.accent-background))
        : (ta.pressed ? Palette.control-background.darker(0.15) : (ta.has-hover ? Palette.control-hover : Palette.control-background));
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: root.primary ? Palette.accent-foreground : Palette.foreground;
            opacity: root.enabled ? 1 : 0.5;
            font-size: 13px;
            font-weight: root.primary ? 600 : 400;
            vertical-alignment: center;
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (root.enabled && (e.text == Key.Return || e.text == " ")) { root.clicked(); return accept; }
            return reject;
        }
    }
    Rectangle {
        border-radius: root.border-radius;
        border-width: fs.has-focus ? 3px : 0px;
        border-color: Palette.accent-background;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component LineEdit inherits FocusScope {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder-text;
    in property <InputType> input-type <=> ti.input-type;
    callback accepted(string);
    callback edited(string);
    forward-focus: ti;
    focus-on-tab-navigation: false;
    height: 32px;
    Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.control-background;
        clip: true;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Rectangle {
                ti := TextInput {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    font-size: 13px;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    single-line: true;
                    selection-background-color: Palette.accent-background;
                    selection-foreground-color: Palette.accent-foreground;
                    accepted => { root.accepted(self.text); }
                    edited => { root.edited(self.text); }
                }
                if ti.text == "": Text {
                    x: 0px;
                    width: parent.width;
                    text: root.placeholder-text;
                    color: Palette.foreground;
                    opacity: 0.5;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            x: 0px;
            y: parent.height - 2px;
            width: parent.width;
            height: 2px;
            background: ti.has-focus ? Palette.accent-background : transparent;
        }
    }
}

component Bar inherits Rectangle {
    in property <float> progress;
    height: 4px;
    border-radius: 2px;
    background: Palette.border;
    Rectangle {
        x: 0px;
        width: parent.width * min(1.0, max(0.0, root.progress));
        border-radius: 2px;
        background: Palette.accent-background;
    }
}

component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled(bool);
    width: 44px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Palette.accent-background : transparent;
    border-width: root.checked ? 0px : 1px;
    border-color: Palette.foreground.with-alpha(0.6);
    Rectangle {
        width: ta.pressed ? 17px : 14px;
        height: 14px;
        border-radius: 7px;
        background: root.checked ? Palette.accent-foreground : Palette.foreground.with-alpha(0.85);
        x: root.checked ? parent.width - self.width - 5px : 5px;
        y: (parent.height - self.height) / 2;
        animate x { duration: 120ms; }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        border-radius: root.border-radius;
        border-width: fs.has-focus ? 3px : 0px;
        border-color: Palette.accent-background;
    }
    ta := TouchArea {
        // a fingertip is bigger than the 44x22 switch
        x: Device.touch ? -10px : 0px;
        y: Device.touch ? -12px : 0px;
        width: parent.width + (Device.touch ? 20px : 0px);
        height: parent.height + (Device.touch ? 24px : 0px);
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component Dropdown inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(string);
    min-width: 140px;
    height: Device.touch ? 44px : 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.border;
    background: ta.has-hover ? Palette.control-hover : Palette.control-background;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.model[root.current-index];
            color: Palette.foreground;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Image {
            source: @image-url("icons/chevron-down.svg");
            colorize: Palette.foreground;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            opacity: 0.7;
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                if (Device.tv) {
                    // a remote can't pick from a popup list: Select steps to the next choice instead
                    root.current-index = mod(root.current-index + 1, max(1, root.model.length));
                    root.selected(root.model[root.current-index]);
                } else {
                    pop.show();
                }
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        border-radius: root.border-radius;
        border-width: fs.has-focus ? 3px : 0px;
        border-color: Palette.accent-background;
    }
    ta := TouchArea {
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: max(root.width, 200px);
        height: min(300px, root.model.length * (Device.touch ? 46px : 34px) + 12px);
        Rectangle {
            background: Palette.alternate-background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            ScrollView {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for t[i] in root.model: Rectangle {
                        height: Device.touch ? 44px : 32px;
                        border-radius: 4px;
                        background: (i == root.current-index || ra.has-hover) ? Palette.control-hover : transparent;
                        if i == root.current-index: Rectangle {
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            width: 3px;
                            height: 14px;
                            border-radius: 2px;
                            background: Palette.accent-background;
                        }
                        Text {
                            x: 14px;
                            width: parent.width - 20px;
                            text: t;
                            color: Palette.foreground;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ra := TouchArea {
                            clicked => {
                                root.current-index = i;
                                root.selected(t);
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingCard inherits Rectangle {
    background: Palette.control-background;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    VerticalLayout {
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> divider: true;
    /// Narrow screens (phones in portrait): the control goes under the text instead of beside it.
    property <bool> stacked: Scale.window-w < 600px;
    property <length> pad: 16px;
    // Laid out by hand: a layout can't size a row from wrapped text, so the row's height is computed
    // from the wrapped text's own height at the width it is given.
    property <length> text-w: root.stacked ? root.width - 2 * root.pad : root.width - 2 * root.pad - ctl.preferred-width - 16px;
    property <length> text-h: ttl.preferred-height + (root.description != "" ? 2px + dsc.preferred-height : 0px);
    min-height: max(60px, 20px + root.text-h + (root.stacked ? 8px + ctl.preferred-height : 0px));
    ttl := Text {
        x: root.pad;
        y: root.stacked ? 10px : (root.height - root.text-h) / 2;
        width: root.text-w;
        text: root.title;
        font-size: 14px;
        color: Palette.foreground;
        overflow: elide;
    }
    dsc := Text {
        x: root.pad;
        y: ttl.y + ttl.preferred-height + 2px;
        width: root.text-w;
        visible: root.description != "";
        text: root.description;
        font-size: 12px;
        color: Palette.foreground;
        opacity: 0.6;
        wrap: word-wrap;
    }
    ctl := HorizontalLayout {
        spacing: 8px;
        alignment: start;
        x: root.stacked ? root.pad : root.width - root.pad - self.preferred-width;
        y: root.stacked ? root.height - 10px - self.preferred-height : (root.height - self.preferred-height) / 2;
        width: self.preferred-width;
        height: self.preferred-height;
        @children
    }
    if root.divider: Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 32px;
        height: 1px;
        background: Palette.border;
    }
}

component SectionLabel inherits Text {
    color: Palette.foreground;
    opacity: 0.65;
    font-size: 13px;
    font-weight: 600;
}

export struct Card {
    id: string,
    kind: string,
    title: string,
    subtitle: string,
    image: image,
    progress: float,
    played: bool,
    favorite: bool,
    current: bool,
    next-season: bool,
    badge: string,
    badge-kind: int,
    overview: string,
    followed: bool,
    /// An image is on its way: show the shimmer and fade the picture in.
    loading: bool,
}

/// State and actions for the press-and-hold / right-click menu on a poster.
export global CardMenu {
    in-out property <bool> played;
    in-out property <bool> favorite;
    in-out property <Card> card;
    callback opened(string);
    callback flag(string, bool, bool); // id, favourite?, new value
    callback cw-hide(string, string);
    callback play(string, bool);
}

/// The signed-in Seerr user's remaining requests, shown under the tabs of every Requests page.
export global SrQuota {
    in-out property <bool> shown: false;
    in-out property <string> movie-text;
    in-out property <float> movie-frac: 1;
    in-out property <bool> movie-limited: false;
    in-out property <string> tv-text;
    in-out property <float> tv-frac: 1;
    in-out property <bool> tv-limited: false;
}

