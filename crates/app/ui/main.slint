/// Colours of the status tags: 1 requested, 2 processing, 3 partial, 4 available, 5 declined.
global Tags {
    pure public function color(kind: int) -> color {
        return kind == 4 ? #1f9d55 : (kind == 3 ? #0f9fa8 : (kind == 2 ? #2f6fe4 : (kind == 5 ? #d64545 : (kind == 1 ? #d19a14 : #5b6475))));
    }
}

export struct Prog {
    id: string,
    title: string,
    sub: string,
    x: length,
    w: length,
    now: bool,
}

export struct Chan {
    id: string,
    name: string,
    number: string,
